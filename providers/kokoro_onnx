#!/usr/bin/env bash
# desc: Kokoro quality, fast start. Runs on CPU or GPU.
# title: Kokoro ONNX
# kind: local
# probe: d="$(jq -r '.kokoro_onnx.device // "cpu"' "$TTS_CONFIG" 2>/dev/null)"; e=kokoro_onnx; [[ "$d" == gpu ]] && e=kokoro_onnx_gpu; dir="${TTS_DATA_DIR:-$HOME/.local/share/omarchy-tts}/engines/$e"; [[ -x "$dir/bin/python" && -s "$dir/models/kokoro-v1.0.onnx" && -s "$dir/models/voices-v1.0.bin" && "$(cat "$dir/.lock-sha256" 2>/dev/null)" == "$(sha256sum "$TTS_PLUGIN_DIR/lib/engines/$e.lock" | cut -d' ' -f1)" ]]
# install: managed Python 3.12 venv from lib/engines/kokoro_onnx.lock (CPU) or kokoro_onnx_gpu.lock (GPU) · verified model files
# voices: bundled
# devices: cpu gpu
# ratemin: 0.5
# ratemax: 2.0
set -uo pipefail
umask 077
source "$TTS_PLUGIN_DIR/lib/play.sh"

DEVICE="$(jq -r '.kokoro_onnx.device // "cpu"' "$TTS_CONFIG" 2>/dev/null)"
[[ "$DEVICE" == gpu ]] || DEVICE=cpu
ENGINE_NAME=kokoro_onnx
[[ "$DEVICE" == gpu ]] && ENGINE_NAME=kokoro_onnx_gpu
ENGINE_DIR="${TTS_DATA_DIR:-$HOME/.local/share/omarchy-tts}/engines/$ENGINE_NAME"
KPY="$ENGINE_DIR/bin/python"
if [[ ! -x "$KPY" ]]; then
  echo "speak: kokoro_onnx ($DEVICE) not installed." >&2
  echo "  Install it from the Provider tab." >&2
  notify-send -a "Speak" "Kokoro ONNX not installed" "Install it from the Provider tab." 2>/dev/null
  exit 127
fi

# An environment this release did not build from its shipped lock is not
# an installed engine, whatever it contains.
if [[ "$(cat "$ENGINE_DIR/.lock-sha256" 2>/dev/null)" != "$(sha256sum "$TTS_PLUGIN_DIR/lib/engines/$ENGINE_NAME.lock" | cut -d' ' -f1)" ]]; then
  echo "speak: kokoro_onnx was installed by an earlier release; reinstall it from the Provider tab." >&2
  notify-send -a "Speak" "Kokoro ONNX needs reinstalling" "Reinstall it from the Provider tab." 2>/dev/null
  exit 127
fi

VOICE="${TTS_VOICE:-}"
[[ -z "$VOICE" ]] && VOICE="$(jq -r '.kokoro_onnx.voice // "af_heart"' "$TTS_CONFIG" 2>/dev/null)"
[[ -z "$VOICE" || "$VOICE" == "null" ]] && VOICE="af_heart"
[[ "$VOICE" =~ ^[a-z]{2}_[a-z]+$ ]] || { echo "speak: kokoro_onnx: invalid voice name" >&2; exit 65; }
# British voices need British phonemes; every other bundled voice used here
# is American English.
LANG_CODE=en-us
[[ "$VOICE" == b* ]] && LANG_CODE=en-gb

# The model and voice pack are the files the installer verified against
# lib/engines/models.json. Hashing 350 MB on every utterance would cost more
# than synthesis, so a full check is recorded against the file's identity
# (inode, size, mtime) and repeated whenever that identity changes.
MODELS="$ENGINE_DIR/models"
MANIFEST="$TTS_PLUGIN_DIR/lib/engines/models.json"
verify_model() { # <file name>
  local want size stamp_file identity got
  want="$(jq -r --arg f "$1" '.kokoro_onnx.files[$f].sha256 // empty' "$MANIFEST" 2>/dev/null)"
  size="$(jq -r --arg f "$1" '.kokoro_onnx.files[$f].size // empty' "$MANIFEST" 2>/dev/null)"
  [[ "$want" =~ ^[0-9a-f]{64}$ ]] || { echo "speak: kokoro_onnx: $1 is not a verified model file" >&2; exit 65; }
  [[ -f "$MODELS/$1" && ! -L "$MODELS/$1" ]] || { echo "speak: kokoro_onnx: $1 is missing; reinstall it from the Provider tab" >&2; exit 127; }
  identity="$(stat -c '%i:%s:%Y' "$MODELS/$1")"
  [[ "${identity#*:}" == "$size":* ]] || { echo "speak: kokoro_onnx: $1 failed verification; reinstall it from the Provider tab" >&2; exit 65; }
  stamp_file="$MODELS/.$1.verified"
  [[ ! -L "$stamp_file" && "$(cat "$stamp_file" 2>/dev/null)" == "$want $identity" ]] && return 0
  got="$(sha256sum "$MODELS/$1" | cut -d' ' -f1)"
  [[ "$got" == "$want" ]] || { echo "speak: kokoro_onnx: $1 failed verification; reinstall it from the Provider tab" >&2; exit 65; }
  printf '%s %s\n' "$want" "$identity" > "$stamp_file" 2>/dev/null || true
}
verify_model kokoro-v1.0.onnx
verify_model voices-v1.0.bin

RATE="${TTS_RATE:-1.0}"
# espeak-ng and onnxruntime write progress and graph warnings to stderr on
# every run; none of it is actionable, and it buries real errors.
KOKORO_VOICE="$VOICE" KOKORO_LANG="$LANG_CODE" KOKORO_SPEED="$RATE" \
KOKORO_DEVICE="$DEVICE" KOKORO_MODELS="$MODELS" \
"$KPY" 3<&0 - <<'KOKORO_PY' 2>/dev/null | play_raw 24000 1
import asyncio, os, sys
import numpy as np
import onnxruntime as ort
from kokoro_onnx import Kokoro

models = os.environ["KOKORO_MODELS"]
providers = ["CPUExecutionProvider"]
if os.environ.get("KOKORO_DEVICE") == "gpu":
    # The CUDA and cuDNN libraries come from the engine's own nvidia-* wheels.
    if hasattr(ort, "preload_dlls"):
        ort.preload_dlls()
    if "CUDAExecutionProvider" in ort.get_available_providers():
        providers.insert(0, "CUDAExecutionProvider")
options = ort.SessionOptions()
options.log_severity_level = 3
session = ort.InferenceSession(os.path.join(models, "kokoro-v1.0.onnx"), options, providers=providers)
kokoro = Kokoro.from_session(session, os.path.join(models, "voices-v1.0.bin"))
with os.fdopen(3, encoding="utf-8") as source:
    text = source.read()


async def speak() -> None:
    # Sentence-sized chunks, so playback starts after the first one rather
    # than after the whole selection has been synthesised.
    async for samples, _rate in kokoro.create_stream(
            text, voice=os.environ["KOKORO_VOICE"],
            speed=float(os.environ.get("KOKORO_SPEED", "1.0")),
            lang=os.environ.get("KOKORO_LANG", "en-us")):
        clipped = np.clip(np.asarray(samples, dtype="float32"), -1.0, 1.0)
        sys.stdout.buffer.write((clipped * 32767.0).astype("<i2").tobytes())
        sys.stdout.buffer.flush()


asyncio.run(speak())
KOKORO_PY
